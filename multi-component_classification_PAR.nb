Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "@", "predDisp"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"predDisp", "[", 
   RowBox[{"params_", "?", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"AllTrue", "[", 
       RowBox[{"#", ",", 
        RowBox[{"Function", "[", 
         RowBox[{"x", ",", 
          RowBox[{"NonNegative", "[", 
           RowBox[{"x", "[", 
            RowBox[{"[", "2", "]"}], "]"}], "]"}]}], "]"}]}], "]"}], "&"}], 
     ")"}]}], "]"}], ":=", 
  RowBox[{"Block", "[", 
   RowBox[{
    RowBox[{"{", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"HSS", "=", 
       RowBox[{
        RowBox[{"testInstab", "[", "params", "]"}], "[", 
        RowBox[{"[", 
         RowBox[{"-", "2"}], "]"}], "]"}]}], ",", "\[IndentingNewLine]", 
      "JAC", ",", "\[IndentingNewLine]", "nv", ",", "\[IndentingNewLine]", 
      "vecD", ",", "\[IndentingNewLine]", "vecE", ",", "\[IndentingNewLine]", 
      "dispRelPred", ",", "\[IndentingNewLine]", "qMin", ",", "qMax", ",", 
      "\[IndentingNewLine]", "qss", ",", "loc"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{"(*", 
     RowBox[{
     "The", " ", "nullcline", " ", "tangent", " ", "vectors", " ", "lie", " ",
       "in", " ", "the", " ", "nullspace", " ", "of", " ", "the", " ", 
      "Jacobian", " ", "of", " ", "the", " ", "reaction", " ", "terms"}], 
     "*)"}], "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"JAC", "=", 
      RowBox[{
       RowBox[{
        RowBox[{"jac", "/.", 
         RowBox[{"Thread", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"cDD", ",", "cDT", ",", "cE", ",", "md", ",", "mde"}], 
            "}"}], "\[Rule]", "HSS"}], "]"}]}], "/.", "params"}], "/.", 
       RowBox[{"q", "->", "0"}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"nv", "=", 
      RowBox[{"NullSpace", "[", "JAC", "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{
       RowBox[{
       "Find", " ", "the", " ", "vectors", " ", "in", " ", "the", " ", 
        "nullspace", " ", "that", " ", "only", " ", "vary", " ", "total", " ",
         "MinD", " ", 
        RowBox[{"(", "vecD", ")"}], " ", "or", " ", "total", " ", "MinE", " ", 
        RowBox[{"(", "vecE", ")"}], " ", "concentration"}], ",", " ", 
       "respectively"}], "*)"}], "\[IndentingNewLine]", 
     RowBox[{"vecD", "=", 
      RowBox[{
       RowBox[{
        RowBox[{"#", "/", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"0", ",", "1", ",", "0", ",", "1", ",", "0"}], "}"}], ".",
            "#"}], ")"}]}], "&"}], "@", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{"a", " ", 
            RowBox[{"nv", "[", 
             RowBox[{"[", "1", "]"}], "]"}]}], "+", 
           RowBox[{"b", " ", 
            RowBox[{"nv", "[", 
             RowBox[{"[", "2", "]"}], "]"}]}]}], ")"}], "/.", 
         RowBox[{"First", "@", 
          RowBox[{"Solve", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              RowBox[{
               RowBox[{
                RowBox[{"{", 
                 RowBox[{"0", ",", "0", ",", "1", ",", "0", ",", "1"}], "}"}],
                 ".", 
                RowBox[{"(", 
                 RowBox[{
                  RowBox[{"a", " ", 
                   RowBox[{"nv", "[", 
                    RowBox[{"[", "1", "]"}], "]"}]}], "+", 
                  RowBox[{"b", " ", 
                   RowBox[{"nv", "[", 
                    RowBox[{"[", "2", "]"}], "]"}]}]}], ")"}]}], "==", "0"}], 
              ",", 
              RowBox[{
               RowBox[{"a", "+", "b"}], "==", "1"}]}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{"a", ",", "b"}], "}"}]}], "]"}]}]}], ")"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"vecE", "=", 
      RowBox[{
       RowBox[{
        RowBox[{"#", "/", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"0", ",", "0", ",", "1", ",", "0", ",", "1"}], "}"}], ".",
            "#"}], ")"}]}], "&"}], "@", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{"a", " ", 
            RowBox[{"nv", "[", 
             RowBox[{"[", "1", "]"}], "]"}]}], "+", 
           RowBox[{"b", " ", 
            RowBox[{"nv", "[", 
             RowBox[{"[", "2", "]"}], "]"}]}]}], ")"}], "/.", 
         RowBox[{"First", "@", 
          RowBox[{"Solve", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              RowBox[{
               RowBox[{
                RowBox[{"{", 
                 RowBox[{"0", ",", "1", ",", "0", ",", "1", ",", "0"}], "}"}],
                 ".", 
                RowBox[{"(", 
                 RowBox[{
                  RowBox[{"a", " ", 
                   RowBox[{"nv", "[", 
                    RowBox[{"[", "1", "]"}], "]"}]}], "+", 
                  RowBox[{"b", " ", 
                   RowBox[{"nv", "[", 
                    RowBox[{"[", "2", "]"}], "]"}]}]}], ")"}]}], "==", "0"}], 
              ",", 
              RowBox[{
               RowBox[{"a", "+", "b"}], "==", "1"}]}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{"a", ",", "b"}], "}"}]}], "]"}]}]}], ")"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{
      "Approximation", " ", "of", " ", "the", " ", "leading", " ", "two", " ",
        "eigenvalues", " ", "of", " ", "the", " ", "dispersion", " ", 
       "relation"}], "*)"}], "\[IndentingNewLine]", 
     RowBox[{"dispRelPred", "=", 
      RowBox[{
       RowBox[{"Eigenvalues", "[", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{
             RowBox[{"DD", " ", 
              RowBox[{"vecD", "[", 
               RowBox[{"[", "2", "]"}], "]"}]}], "+", 
             RowBox[{
              RowBox[{"DD", "/", 
               RowBox[{"(", 
                RowBox[{"1", "+", 
                 RowBox[{
                  RowBox[{"DD", "/", "\[Lambda]"}], " ", 
                  RowBox[{"q", "^", "2"}]}]}], ")"}]}], 
              RowBox[{"vecD", "[", 
               RowBox[{"[", "1", "]"}], "]"}]}], "+", 
             RowBox[{"Dd", " ", 
              RowBox[{"vecD", "[", 
               RowBox[{"[", "4", "]"}], "]"}]}]}], ",", 
            RowBox[{
             RowBox[{"DD", " ", 
              RowBox[{"vecE", "[", 
               RowBox[{"[", "2", "]"}], "]"}]}], "+", 
             RowBox[{
              RowBox[{"DD", "/", 
               RowBox[{"(", 
                RowBox[{"1", "+", 
                 RowBox[{
                  RowBox[{"DD", "/", "\[Lambda]"}], " ", 
                  RowBox[{"q", "^", "2"}]}]}], ")"}]}], 
              RowBox[{"vecE", "[", 
               RowBox[{"[", "1", "]"}], "]"}]}], "+", 
             RowBox[{"Dd", " ", 
              RowBox[{"vecE", "[", 
               RowBox[{"[", "4", "]"}], "]"}]}]}]}], "}"}], ",", 
          "\[IndentingNewLine]", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{
             RowBox[{"DE", " ", 
              RowBox[{"vecD", "[", 
               RowBox[{"[", "3", "]"}], "]"}]}], "+", 
             RowBox[{"Dde", " ", 
              RowBox[{"vecD", "[", 
               RowBox[{"[", "5", "]"}], "]"}]}]}], ",", 
            RowBox[{
             RowBox[{"DE", " ", 
              RowBox[{"vecE", "[", 
               RowBox[{"[", "3", "]"}], "]"}]}], "+", 
             RowBox[{"Dde", " ", 
              RowBox[{"vecE", "[", 
               RowBox[{"[", "5", "]"}], "]"}]}]}]}], "}"}]}], "}"}], "]"}], "/.",
        "params"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{
      "Find", " ", "the", " ", "zero", " ", "crossing", " ", "of", " ", "the",
        " ", "dispersion", " ", "relation", " ", 
       RowBox[{"(", 
        RowBox[{"real", " ", "part"}], ")"}], " ", "or", " ", "return", " ", 
       "0", " ", "if", " ", "not", " ", "existent"}], "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{"qMin", "=", 
      RowBox[{
       RowBox[{
        RowBox[{"Quiet", "[", 
         RowBox[{"Check", "[", 
          RowBox[{
           RowBox[{"Abs", "@", 
            RowBox[{"(", 
             RowBox[{"q", "/.", 
              RowBox[{"FindRoot", "[", 
               RowBox[{
                RowBox[{
                 RowBox[{"Re", "@", "#"}], "==", "0"}], ",", 
                RowBox[{"{", 
                 RowBox[{"q", ",", "0.1"}], "}"}]}], "]"}]}], ")"}]}], ",", 
           "0"}], "]"}], "]"}], "&"}], "/@", "dispRelPred"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{
      "qss", " ", "approximation", " ", "of", " ", "the", " ", "dispersion", 
       " ", "relation"}], "*)"}], "\[IndentingNewLine]", 
     RowBox[{"qss", "=", 
      RowBox[{"Min", "@", 
       RowBox[{"Re", "[", 
        RowBox[{
         RowBox[{"Eigenvalues", "[", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              RowBox[{
               RowBox[{"DD", " ", 
                RowBox[{"vecD", "[", 
                 RowBox[{"[", "2", "]"}], "]"}]}], "+", 
               RowBox[{"DD", " ", 
                RowBox[{"vecD", "[", 
                 RowBox[{"[", "1", "]"}], "]"}]}], "+", 
               RowBox[{"Dd", " ", 
                RowBox[{"vecD", "[", 
                 RowBox[{"[", "4", "]"}], "]"}]}]}], ",", 
              RowBox[{
               RowBox[{"DD", " ", 
                RowBox[{"vecE", "[", 
                 RowBox[{"[", "2", "]"}], "]"}]}], "+", 
               RowBox[{"DD", " ", 
                RowBox[{"vecE", "[", 
                 RowBox[{"[", "1", "]"}], "]"}]}], "+", 
               RowBox[{"Dd", " ", 
                RowBox[{"vecE", "[", 
                 RowBox[{"[", "4", "]"}], "]"}]}]}]}], "}"}], ",", 
            "\[IndentingNewLine]", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{
               RowBox[{"DE", " ", 
                RowBox[{"vecD", "[", 
                 RowBox[{"[", "3", "]"}], "]"}]}], "+", 
               RowBox[{"Dde", " ", 
                RowBox[{"vecD", "[", 
                 RowBox[{"[", "5", "]"}], "]"}]}]}], ",", 
              RowBox[{
               RowBox[{"DE", " ", 
                RowBox[{"vecE", "[", 
                 RowBox[{"[", "3", "]"}], "]"}]}], "+", 
               RowBox[{"Dde", " ", 
                RowBox[{"vecE", "[", 
                 RowBox[{"[", "5", "]"}], "]"}]}]}]}], "}"}]}], "}"}], "]"}], 
         "/.", "params"}], "]"}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"loc", "=", 
      RowBox[{"Chop", "@", 
       RowBox[{"Max", "@", 
        RowBox[{"Re", "[", 
         RowBox[{"Eigenvalues", "[", "JAC", "]"}], "]"}]}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{"-", 
         RowBox[{"q", "^", "2"}]}], " ", "dispRelPred"}], ",", "qMin", ",", 
