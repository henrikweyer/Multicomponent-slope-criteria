Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "@", "hss"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"hss", "[", "params_", "]"}], ":=", 
   RowBox[{"Block", "[", 
    RowBox[{
     RowBox[{"{", "sol", "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"sol", "=", 
       RowBox[{"NSolve", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"0", "\[Equal]", "f"}], ",", 
            RowBox[{"rhoD", "\[Equal]", 
             RowBox[{"cDT", "+", "md"}]}], ",", 
            RowBox[{"rhoE", "\[Equal]", 
             RowBox[{"cE", "+", "mde"}]}], ",", 
            RowBox[{"cDD", "==", "0"}]}], "}"}], "/.", "params"}], ",", 
         RowBox[{"{", 
          RowBox[{"cDD", ",", "cDT", ",", "cE", ",", "md", ",", "mde"}], 
          "}"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"Select", "[", 
       RowBox[{
        RowBox[{
