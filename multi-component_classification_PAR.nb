   RowBox[{"Options", "[", "testInstab", "]"}], "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"\"\<gpts\>\"", "\[Rule]", "100"}], ",", 
     RowBox[{"\"\<maxQ\>\"", "\[Rule]", "5"}]}], "}"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"testInstab", "[", 
    RowBox[{
     RowBox[{"params_", "?", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"AllTrue", "[", 
         RowBox[{"#", ",", 
          RowBox[{"Function", "[", 
           RowBox[{"x", ",", 
            RowBox[{"NonNegative", "[", 
             RowBox[{"x", "[", 
              RowBox[{"[", "2", "]"}], "]"}], "]"}]}], "]"}]}], "]"}], "&"}], 
       ")"}]}], ",", 
     RowBox[{"opts", ":", 
      RowBox[{"OptionsPattern", "[", "]"}]}]}], "]"}], ":=", 
   RowBox[{"Block", "[", 
    RowBox[{
     RowBox[{"{", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"dispRel", "=", 
        RowBox[{"dispersionRelation", "[", 
         RowBox[{"params", ",", 
          RowBox[{"\"\<gpts\>\"", "\[Rule]", 
           RowBox[{"OptionValue", "[", "\"\<gpts\>\"", "]"}]}], ",", 
          RowBox[{"\"\<maxQ\>\"", "\[Rule]", 
           RowBox[{"OptionValue", "[", "\"\<maxQ\>\"", "]"}]}]}], "]"}]}], 
       ",", "\[IndentingNewLine]", "HSS", ",", "\[IndentingNewLine]", 
       "hssInd", ",", "\[IndentingNewLine]", "hssTypes", ",", 
       "\[IndentingNewLine]", "hssLS", ",", "\[IndentingNewLine]", "sigma0", 
       ",", "\[IndentingNewLine]", "qNZero", ",", "sigmaNZero", ",", 
       "\[IndentingNewLine]", "sigmac", ",", "qc", ",", "\[IndentingNewLine]",
        "zero"}], " ", 
      RowBox[{"(*", 
       RowBox[{
        RowBox[{
        "test", " ", "whether", " ", "there", " ", "the", " ", "dispersion", 
         " ", "relation", " ", "is", " ", "below", " ", "0", " ", "at", " ", 
         "q"}], "<", "qc"}], "*)"}], "\[IndentingNewLine]", "}"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{
       RowBox[{"find", " ", "laterally"}], "-", 
       RowBox[{"unstable", " ", "HSS"}]}], "*)"}], "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"Length", "[", 
          RowBox[{"dispRel", "[", 
           RowBox[{"[", "1", "]"}], "]"}], "]"}], "\[Equal]", "1"}], ",", 
        "\[IndentingNewLine]", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"HSS", "=", 
