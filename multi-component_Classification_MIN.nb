           RowBox[{"{", 
            RowBox[{"cDD", ",", "cDT", ",", "cE", ",", "md", ",", "mde"}], 
            "}"}], "\[Rule]", "HSS"}], "]"}]}], "/.", "params"}], "/.", 
       RowBox[{"q", "->", "0"}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"nv", "=", 
      RowBox[{"NullSpace", "[", "JAC", "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{
       RowBox[{
       "Find", " ", "the", " ", "vectors", " ", "in", " ", "the", " ", 
        "nullspace", " ", "that", " ", "only", " ", "vary", " ", "total", " ",
         "MinD", " ", 
        RowBox[{"(", "vecD", ")"}], " ", "or", " ", "total", " ", "MinE", " ", 
        RowBox[{"(", "vecE", ")"}], " ", "concentration"}], ",", " ", 
       "respectively"}], "*)"}], "\[IndentingNewLine]", 
     RowBox[{"vecD", "=", 
      RowBox[{
       RowBox[{
        RowBox[{"#", "/", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"1", ",", "1", ",", "0", ",", "1", ",", "1"}], "}"}], ".",
            "#"}], ")"}]}], "&"}], "@", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{"a", " ", 
            RowBox[{"nv", "[", 
             RowBox[{"[", "1", "]"}], "]"}]}], "+", 
           RowBox[{"b", " ", 
            RowBox[{"nv", "[", 
             RowBox[{"[", "2", "]"}], "]"}]}]}], ")"}], "/.", 
         RowBox[{"First", "@", 
          RowBox[{"Solve", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              RowBox[{
               RowBox[{
                RowBox[{"{", 
                 RowBox[{"0", ",", "0", ",", "1", ",", "0", ",", "1"}], "}"}],
                 ".", 
                RowBox[{"(", 
                 RowBox[{
                  RowBox[{"a", " ", 
                   RowBox[{"nv", "[", 
                    RowBox[{"[", "1", "]"}], "]"}]}], "+", 
                  RowBox[{"b", " ", 
                   RowBox[{"nv", "[", 
                    RowBox[{"[", "2", "]"}], "]"}]}]}], ")"}]}], "==", "0"}], 
              ",", 
              RowBox[{
               RowBox[{"a", "+", "b"}], "==", "1"}]}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{"a", ",", "b"}], "}"}]}], "]"}]}]}], ")"}]}]}], ";", 
